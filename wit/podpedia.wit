package podpedia:kernel@0.3.0;

/// Capabilities the microkernel provides to every plugin.
interface host-capabilities {
    /// Generic HTTP POST. Returns the response body or an error message.
    http-post: func(url: string, body: string) -> result<string, string>;

    /// Generic HTTP GET. Returns the response body or an error message.
    http-fetch: func(url: string) -> result<string, string>;

    /// Download url to dest on the host filesystem.
    http-download: func(url: string, dest: string) -> result<_, string>;

    /// Write data to path on the host filesystem.
    file-write: func(path: string, data: string) -> result<_, string>;

    /// Fire-and-forget log message.
    log-msg: func(msg: string);
}

/// Every Podpedia plugin satisfies this world: one JSON-in / JSON-out
/// execute function. Business types stay in JSON; WIT owns the boundary.
world plugin-world {
    import host-capabilities;

    /// Receive a JSON request, return a JSON response or an error string.
    export execute: func(req-json: string) -> result<string, string>;
}
